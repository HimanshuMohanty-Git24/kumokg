# KumoKG workspace secrets — copy to <workspace>/.kumokg/.env (gitignored automatically). Never commit real keys.
# Process environment variables with the same names take precedence over this file.

# ---------------------------------------------------------------------------
# Tier 2 BYOK extraction (OpenAI-compatible /chat/completions)
# Presets fill base URL + models: groq | openrouter | openai | ollama
# ---------------------------------------------------------------------------
KUMOKG_LLM_PRESET=groq
KUMOKG_LLM_API_KEY=
# Optional overrides (any OpenAI-compatible endpoint, e.g. vLLM, LM Studio, Together, Azure OpenAI proxy):
KUMOKG_LLM_BASE_URL=
KUMOKG_LLM_MODEL=
KUMOKG_VLM_MODEL=
KUMOKG_LLM_CONCURRENCY=4
KUMOKG_LLM_TIMEOUT=60

# ---------------------------------------------------------------------------
# Optional live push targets (export --target <name> --push)
# ---------------------------------------------------------------------------
# Neo4j
KUMOKG_NEO4J_URI=bolt://localhost:7687
KUMOKG_NEO4J_USER=neo4j
KUMOKG_NEO4J_PASSWORD=
KUMOKG_NEO4J_DATABASE=neo4j
# PostgreSQL (+ Apache AGE / pgvector)
KUMOKG_POSTGRES_DSN=postgresql://user:password@localhost:5432/kumokg
# Memgraph
KUMOKG_MEMGRAPH_URI=bolt://localhost:7688
KUMOKG_MEMGRAPH_USER=
KUMOKG_MEMGRAPH_PASSWORD=
# FalkorDB
KUMOKG_FALKORDB_HOST=localhost
KUMOKG_FALKORDB_PORT=6379
KUMOKG_FALKORDB_PASSWORD=
KUMOKG_FALKORDB_GRAPH=kumokg
# Amazon Neptune (bulk loader when the S3 bucket is set, otherwise Gremlin / SPARQL)
KUMOKG_NEPTUNE_ENDPOINT=https://your-cluster.cluster-xxxx.us-east-1.neptune.amazonaws.com:8182
KUMOKG_NEPTUNE_S3_BUCKET=
KUMOKG_NEPTUNE_S3_PREFIX=kumokg/neptune
KUMOKG_NEPTUNE_IAM_ROLE_ARN=
KUMOKG_NEPTUNE_REGION=us-east-1
# ArangoDB
KUMOKG_ARANGO_URL=http://localhost:8529
KUMOKG_ARANGO_DB=kumokg
KUMOKG_ARANGO_USER=root
KUMOKG_ARANGO_PASSWORD=
# TigerGraph
KUMOKG_TIGERGRAPH_HOST=https://your-instance.i.tgcloud.io
KUMOKG_TIGERGRAPH_GRAPH=KumoKG
KUMOKG_TIGERGRAPH_USER=tigergraph
KUMOKG_TIGERGRAPH_PASSWORD=
KUMOKG_TIGERGRAPH_SECRET=
# JanusGraph / any TinkerPop Gremlin server
KUMOKG_GREMLIN_URL=ws://localhost:8182/gremlin
# RDF triple stores (SPARQL 1.1 Graph Store HTTP Protocol)
KUMOKG_SPARQL_GSP_URL=http://localhost:7878/store
KUMOKG_SPARQL_QUERY_URL=http://localhost:7878/query
KUMOKG_SPARQL_USER=
KUMOKG_SPARQL_PASSWORD=
# DuckDB / MotherDuck
KUMOKG_DUCKDB_PATH=./kumokg-live.duckdb
