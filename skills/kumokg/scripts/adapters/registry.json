{
  "version": 1,
  "adapters": [
    {
      "name": "neo4j", "title": "Neo4j 5.x", "module": "neo4j_adapter", "class": "Neo4jAdapter", "extra": "neo4j",
      "formats": ["nodes_*.csv", "edges_*.csv", "schema.cypher", "import.cypher"],
      "env": ["KUMOKG_NEO4J_URI", "KUMOKG_NEO4J_USER", "KUMOKG_NEO4J_PASSWORD", "KUMOKG_NEO4J_DATABASE"],
      "push": "Bolt driver, batched UNWIND ... MERGE", "modes": {}
    },
    {
      "name": "postgres", "title": "PostgreSQL (+ Apache AGE / pgvector)", "module": "postgres_adapter", "class": "PostgresAdapter", "extra": "postgres",
      "formats": ["schema.sql", "data/*.csv", "load.sql", "age.sql", "pgvector.sql"],
      "env": ["KUMOKG_POSTGRES_DSN"],
      "push": "psycopg COPY in one transaction", "modes": {"pg_mode": ["plain", "age", "pgvector"]}
    },
    {
      "name": "memgraph", "title": "Memgraph", "module": "memgraph_adapter", "class": "MemgraphAdapter", "extra": "memgraph",
      "formats": ["nodes_*.csv", "edges_*.csv", "schema.cypherl", "load.cypherl"],
      "env": ["KUMOKG_MEMGRAPH_URI", "KUMOKG_MEMGRAPH_USER", "KUMOKG_MEMGRAPH_PASSWORD"],
      "push": "Bolt driver, batched UNWIND ... MERGE", "modes": {}
    },
    {
      "name": "falkordb", "title": "FalkorDB", "module": "falkordb_adapter", "class": "FalkorDBAdapter", "extra": "falkordb",
      "formats": ["nodes_*.csv", "edges_*.csv", "schema.cypher", "load_bulk.sh"],
      "env": ["KUMOKG_FALKORDB_HOST", "KUMOKG_FALKORDB_PORT", "KUMOKG_FALKORDB_PASSWORD", "KUMOKG_FALKORDB_GRAPH"],
      "push": "falkordb client, parameterised UNWIND", "modes": {}
    },
    {
      "name": "neptune", "title": "Amazon Neptune (LPG or RDF)", "module": "neptune_adapter", "class": "NeptuneAdapter", "extra": "neptune",
      "formats": ["vertices_*.csv", "edges_*.csv", "loader-request.json", "data.nq", "data.ttl"],
      "env": ["KUMOKG_NEPTUNE_ENDPOINT", "KUMOKG_NEPTUNE_S3_BUCKET", "KUMOKG_NEPTUNE_S3_PREFIX", "KUMOKG_NEPTUNE_IAM_ROLE_ARN", "KUMOKG_NEPTUNE_REGION"],
      "push": "S3 + Neptune Bulk Loader, or Gremlin / SPARQL endpoint", "modes": {"neptune_mode": ["lpg", "rdf"]}
    },
    {
      "name": "arangodb", "title": "ArangoDB", "module": "arangodb_adapter", "class": "ArangoDBAdapter", "extra": "arangodb",
      "formats": ["vertices/*.jsonl", "edges/*.jsonl", "graph_definition.json", "import.sh"],
      "env": ["KUMOKG_ARANGO_URL", "KUMOKG_ARANGO_DB", "KUMOKG_ARANGO_USER", "KUMOKG_ARANGO_PASSWORD"],
      "push": "python-arango import_bulk + named graph", "modes": {}
    },
    {
      "name": "tigergraph", "title": "TigerGraph", "module": "tigergraph_adapter", "class": "TigerGraphAdapter", "extra": "tigergraph",
      "formats": ["schema.gsql", "loading_job.gsql", "vertices_*.csv", "edges_*.csv"],
      "env": ["KUMOKG_TIGERGRAPH_HOST", "KUMOKG_TIGERGRAPH_GRAPH", "KUMOKG_TIGERGRAPH_USER", "KUMOKG_TIGERGRAPH_PASSWORD", "KUMOKG_TIGERGRAPH_SECRET"],
      "push": "pyTigerGraph upsertVertices / upsertEdges", "modes": {}
    },
    {
      "name": "janusgraph", "title": "JanusGraph / TinkerPop", "module": "janusgraph_adapter", "class": "JanusGraphAdapter", "extra": "janusgraph",
      "formats": ["schema.groovy", "graph.graphson", "load.groovy"],
      "env": ["KUMOKG_GREMLIN_URL"],
      "push": "gremlinpython coalesce/addV + addE", "modes": {}
    },
    {
      "name": "rdf", "title": "RDF / OWL 2 / SHACL (GraphDB, Stardog, Oxigraph, Jena)", "module": "rdf_adapter", "class": "RDFAdapter", "extra": "rdf",
      "formats": ["ontology.ttl", "shapes.shacl.ttl", "data.ttl", "data.nq", "data.jsonld"],
      "env": ["KUMOKG_SPARQL_GSP_URL", "KUMOKG_SPARQL_QUERY_URL", "KUMOKG_SPARQL_USER", "KUMOKG_SPARQL_PASSWORD"],
      "push": "SPARQL 1.1 Graph Store HTTP Protocol PUT + SPARQL count", "modes": {}
    },
    {
      "name": "duckdb", "title": "DuckDB (DuckPGQ + Parquet + GraphML)", "module": "duckdb_adapter", "class": "DuckDBAdapter", "extra": "",
      "formats": ["nodes.parquet", "edges.parquet", "evidence.parquet", "setup_duckpgq.sql", "graph.graphml", "kumokg.duckdb"],
      "env": ["KUMOKG_DUCKDB_PATH"],
      "push": "ATTACH target database (file or md:) and CREATE TABLE AS", "modes": {}
    }
  ]
}
